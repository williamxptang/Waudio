            <key>NSRequiredContext</key><dict/>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Stop Reading with __NAME__</string></dict>
            <key>NSMessage</key><string>stopReading</string>
            <key>NSPortName</key><string>__NAME__</string>
            <key>NSRequiredContext</key><dict/>
        </dict>
    </array>
    <!-- read by Host.swift; filled in by build_app.sh -->
    <key>WAPython</key><string>__PYTHON__</string>
    <key>WAProject</key><string>__PROJECT__</string>
</dict>
